# Copy this file to .env and replace every replace-me value before first start.
# ENCRYPTION_KEY must be exactly 64 hexadecimal characters.

NEXTAUTH_SECRET=replace-me-with-a-random-secret
SALT=replace-me-with-a-random-salt
ENCRYPTION_KEY=replace-me-with-64-hex-characters
TELEMETRY_ENABLED=false
NEXTAUTH_URL=http://localhost:3100

LANGFUSE_INIT_ORG_ID=nexent-benchmark
LANGFUSE_INIT_ORG_NAME=Nexent Benchmark
LANGFUSE_INIT_PROJECT_ID=nexent-benchmark
LANGFUSE_INIT_PROJECT_NAME=Nexent Benchmark
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=replace-me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace-me
REDIS_AUTH=replace-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-me
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-me
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace-me
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=replace-me
