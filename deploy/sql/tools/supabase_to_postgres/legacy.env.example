# Copy to a private, ignored file outside Git, or export these values in the host shell.
# ROOT_DIR is the original deployment storage root, not the current repository directory.
ROOT_DIR=/absolute/path/to/original/nexent-data
# Optional explicit override. Otherwise legacy_stack.py uses ROOT_DIR/volumes/db/data.
SUPABASE_DATA_DIR=
SUPABASE_LOG_DIR=
SUPABASE_POSTGRES_PASSWORD=
SUPABASE_POSTGRES_DB=supabase
SUPABASE_POSTGRES_USER=postgres
SUPABASE_POSTGRES_PORT=5436
SUPABASE_PUBLISHED_PORT=5436
SUPABASE_KONG_HTTP_PORT=8000
SUPABASE_KONG_HTTPS_PORT=8443
SUPABASE_MIGRATION_BIND_ADDRESS=127.0.0.1
SUPABASE_DB=supabase/postgres:15.8.1.060
SUPABASE_GOTRUE=supabase/gotrue:v2.170.0
SUPABASE_KONG=kong:2.8.1
SUPABASE_MIGRATION_PROJECT=nexent-supabase-migration
SUPABASE_MIGRATION_NETWORK=nexent_supabase_migration
SUPABASE_MIGRATION_DB_CONTAINER=supabase-db-mini
SUPABASE_MIGRATION_AUTH_CONTAINER=supabase-auth-mini
SUPABASE_MIGRATION_KONG_CONTAINER=supabase-kong-mini
# Full legacy auth requires the original signing key and original anon/service-role tokens.
JWT_SECRET=
SUPABASE_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=7200
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
