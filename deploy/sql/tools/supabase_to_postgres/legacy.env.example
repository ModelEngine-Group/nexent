# Copy to a private, ignored file and provide the original deployment values.
# The Shell migration scripts supply the standard images, ports and service names.
ROOT_DIR=/absolute/path/to/original/nexent-data
# Optional. Otherwise the script uses ROOT_DIR/volumes/db/data.
SUPABASE_DATA_DIR=
SUPABASE_POSTGRES_PASSWORD=
# Set these only if the original deployment used different values.
# SUPABASE_DB=supabase/postgres:<original-tag>
# SUPABASE_POSTGRES_DB=<original-database>
# SUPABASE_POSTGRES_USER=<original-user>
# Full legacy auth requires the original signing key and tokens.
JWT_SECRET=
SUPABASE_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_PASSWORD=
