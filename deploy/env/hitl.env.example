# Durable in-loop clarification is enabled by default. Deployment scripts generate
# and persist HITL_ENCRYPTION_KEY when the primary deploy environment leaves it empty.
HITL_ENABLED=true
HITL_ACCEPT_NEW_RUNS=true
HITL_TOOL_APPROVAL_ENABLED=false
HITL_ENCRYPTION_KEY=
HITL_WAIT_SECONDS=86400
HITL_MAX_CONCURRENCY=2
