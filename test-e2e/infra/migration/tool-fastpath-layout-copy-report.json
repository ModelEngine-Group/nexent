{
  "schema_version": 1,
  "scope": "TFP-001 assets brought forward when merging develop into dev/local-tool",
  "changes": [
    "Convert grouped Feature/Case/Change documents to case-centric documents without changing IDs or expectations.",
    "Move fixture helpers to infra/automation/shared and preserve every test selector and assertion in case-local scripts.",
    "Use worker_agents for the renamed upstream configuration field.",
    "Expect upstream CancelledError when cancellation occurs inside executor construction; wrapper cancellation remains RuntimeError.",
    "Discard the old generated Excel view and regenerate the upstream local-only views.",
    "Use the upstream final-answer envelope in real Agent integration checks, preserving all independent final_answer-tool compatibility checks.",
    "Closed-protocol factory fixtures use the upstream strict code_action mode and assert the terminal ActionStep plus returned answer."
  ],
