A2A_CONTROL_TOKEN=replace-for-shared-hosts
A2A_JWT_SECRET=replace-for-shared-hosts
A2A_NACOS_NAMESPACE=public
A2A_NACOS_AGENT_NAME=nexent-a2a-mock

# Nacos 3.2.1 requires valid Base64 values at startup even when auth is disabled.
# The base Compose file provides local-only defaults; replace them on shared hosts.
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
