# Copy outside Git; generate a dedicated test-only credential (at least 16 characters).
# Never reuse a real model/Provider API key for this Mock.
NEXENT_EXTERNAL_MEMORY_API_KEY=
NEXENT_EXTERNAL_MEMORY_PLUGIN=mem0
# Used by Nexent running inside the Docker product network.
NEXENT_EXTERNAL_MEMORY_ENDPOINT=http://memory-provider:18120
