{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profiles", "cases", "recovery_cases"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {"type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$", "not": {"enum": ["local", "restore-local"]}},
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["environment"], "properties": {
          "environment": {"type": "object", "minProperties": 1, "additionalProperties": false,
            "properties": {
              "ENABLE_AIDP_KNOWLEDGE": {"enum": ["true", "false"]},
              "MODEL_ENGINE_ENABLED": {"enum": ["true", "false"]},
              "AIDP_SERVER_URL": {"const": "{mock_product_url}"},
              "AIDP_API_KEY": {"const": "{mock_aidp_key}"},
              "AIDP_TENANT_ID": {"const": "aidp"}
            }
          }
        }
      }
    },
    "cases": {"type": "object", "additionalProperties": {"type": "string"}},
    "recovery_cases": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}}
  }
}
