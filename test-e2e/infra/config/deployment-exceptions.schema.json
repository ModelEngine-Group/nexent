{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profiles", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {"type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$", "not": {"enum": ["local", "restore-local"]}},
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["environment"], "properties": {
          "environment": {"type": "object", "minProperties": 1, "additionalProperties": false,
            "properties": {
              "ENABLE_AIDP_KNOWLEDGE": {"enum": ["true", "false"]},
              "MODEL_ENGINE_ENABLED": {"enum": ["true", "false"]},
              "AIDP_SERVER_URL": {"const": "{mock_product_url}"},
              "AIDP_API_KEY": {"const": "{mock_aidp_key}"},
              "AIDP_TENANT_ID": {"const": "aidp"},
              "NEXENT_AGENT_CORE": {"const": "smolagents"},
              "NEXENT_SANDBOX_DEFAULT_SCOPE": {"const": "session"},
              "NEXENT_SANDBOX_WORKSPACE_MODE": {"const": "bind"},
              "NEXENT_SANDBOX_CONTAINER_WORKSPACE_ROOT": {"const": "/mnt/nexent/workdir"},
              "NEXENT_SANDBOX_FAILURE_POLICY": {"const": "error"},
              "NEXENT_TOOL_FASTPATH_ENABLED": {"const": "true"},
              "NEXENT_TOOL_FASTPATH_ALLOWED_TOOLS": {"const": "ReadSkillConfigTool"}
            }
          }
        }
      }
    },
    "cases": {"type": "object", "additionalProperties": {"type": "string"}},
    "recovery_cases": {"type": "array", "deprecated": true, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}}
  }
}
