{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains", "feature_overrides", "case_overrides"],
  "properties": {
    "schema_version": {"const": 1},
    "domains": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "owner", "feature_categories", "feature_id_patterns"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "feature_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "feature_id_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "feature_overrides": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "case_overrides": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
