# Copy to machine-local config/daily.env. Do not put credentials here.
# The runner derives NEXENT_REPO, NEXENT_TEST_HOME and TEST_ROOT from its paths.
# Existing non-secret suite overrides may be retained when reviewed.
# Optional notification settings, consumed only for explicitly enabled Daily:
FEISHU_REPORT_CHAT_ID=
LARK_CLI=
# Host addresses reachable from the isolated product containers, not URLs.
# Set 127.0.0.1 only when the consumer shares the host network namespace.
NEXENT_TEST_ASSETS_CONTAINER_HOST=
NEXENT_TEST_MCP_CONTAINER_HOST=
