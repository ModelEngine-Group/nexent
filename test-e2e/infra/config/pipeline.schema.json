{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_timeout_seconds",
    "command_timeout_seconds",
    "hooks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "command_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "notify": {
      "type": "boolean",
      "default": false
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/$defs/commands"
        },
        "deploy": {
          "$ref": "#/$defs/commands"
        },
        "preflight": {
          "$ref": "#/$defs/commands"
        }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
